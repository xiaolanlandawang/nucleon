[2026-06-18T17:27:29+08:00][sql] UPDATE `cmf_product`  SET `overview` = '&lt;div style=&quot;max-width: 1200px; margin: 0px auto; padding: 30px 20px; font-family: Arial, sans-serif; line-height: 1.8;&quot;&gt;&lt;div style=&quot;background:#f8f9fb; border:1px solid #e5e7eb; border-radius:12px; padding:28px;&quot;&gt;
&lt;p style=&quot;margin:0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;The double-girder grab overhead crane features a robust double-girder structure and is equipped with a specialized grab, designed for efficient grabbing and handling of bulk materials such as ore, coal, and sand. With lifting capacities ranging from 5 to 32 tons and a working class of A6, it meets the demands of high-intensity operations.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;This equipment is widely used in metallurgy, power generation, ports, waste treatment, and chemical industries. Nucleon Cranes can provide flexible customized solutions based on your specific needs, including grab type, span, lifting height, and speed.&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;' , `update_time` = 1781774849  WHERE  `id` = 214 [ RunTime:0.001816s ]
