[2026-06-18T17:50:28+08:00][sql] UPDATE `cmf_product`  SET `scenario` = '&lt;div style=&quot;width: 100%; padding: 30px 0px; font-family: Arial, sans-serif; line-height: 1.8;&quot;&gt;&lt;div style=&quot;width:100%; background:#f8f9fb; border:1px solid #e5e7eb; border-radius:12px; padding:28px; box-sizing:border-box;&quot;&gt;
&lt;p style=&quot;margin:0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Metallurgy and Steel:&lt;/strong&gt;
            Handling, stacking, and reclaiming raw materials and production by-products such as iron ore, coke, scrap steel, and slag.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Power Generation:&lt;/strong&gt;
            In thermal power plants and waste-to-energy plants, responsible for the extraction, transfer, and ash handling of coal and biomass fuels.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Building Materials Industry:&lt;/strong&gt;
            Grabbing and conveying bulk building materials such as limestone, sand, gravel, and cement clinker.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Ports and Logistics:&lt;/strong&gt;
            Rapid loading and unloading of bulk cargo such as coal, ore, and grain at docks and freight yards.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Mining and Raw Material Processing:&lt;/strong&gt;
            Loading, transferring, and stacking of ore and slag.&lt;/p&gt;
&lt;p style=&quot;margin:16px 0 0; font-size:16px; color:#4b5563; line-height:1.9;&quot;&gt;&lt;strong style=&quot;color:#222;&quot;&gt;Waste Management:&lt;/strong&gt;
            Used for grabbing, sorting, stacking, and feeding of municipal solid waste, industrial waste, and construction waste.&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;' , `update_time` = 1781776228  WHERE  `id` = 214 [ RunTime:0.001908s ]
