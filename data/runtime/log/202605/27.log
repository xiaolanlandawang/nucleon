[2026-05-27T16:46:25+08:00][sql] UPDATE `cmf_option`  SET `option_value` = '{\"about_description\":\"Founded in 2005 and headquartered in Xinxiang, Henan Province, China, Xinxiang Nucleon (Xinxiang) Crane Co., Ltd. is a leading manufacturer specializing in the research, development, production, and sales of overhead cranes, gantry cranes, electric hoists, jib cranes and port cranes etc.. Nucleon has a registered capital of 80 million US dollars, covering an area of 430000 square meters, and owns more than 1500 employees. The company has equipped over 3000 sets of production and testing equipment, providing support for the research and development of high-quality crane equipment. The leading products have been widely used in pillar industries of the national economy such as metallurgy, energy and power, petrochemicals, railways, and aviation, and exported to various parts of the world.\",\"engineering\":[{\"engineering_name\":\"Million\",\"engineering_desc\":\"Nucleon has a registered capital of 80 million US dollars\",\"engineering_num\":\"80\"},{\"engineering_name\":\"m²\",\"engineering_desc\":\"Nucleon covering an area of 430000 square meters\",\"engineering_num\":\"430000\"},{\"engineering_name\":\"Employees\",\"engineering_desc\":\"Nucleon owns more than 1500 employees.\",\"engineering_num\":\"1500\"},{\"engineering_name\":\"Sets\",\"engineering_desc\":\"Nucleon has equipped over 3000 sets of production and testing equipment\",\"engineering_num\":\"3000\"}],\"about_img\":\"admin\\/20260527\\/6e1caa71d0aec007314dc24b595d396f.png\",\"about_bg_img\":\"admin\\/20260527\\/6e1caa71d0aec007314dc24b595d396f.png\",\"about_right_bg_img\":\"admin\\/20260527\\/31951f09d3f519ef04f57a08b5390f1c.png\",\"choose_description\":\"In modern industrial development worldwide, smooth and efficient material handling and cargo movement play a vital role in daily production operations. A durable and well-built lifting equipment is essential to streamline your workflow. As a professional crane manufacturer based in China, WEIHUA has earned wide recognition and solid trust across the industry. Whether you plan to procure standard lifting machinery or look for tailored lifting solutions, we are fully capable of meeting all your practical demands. We offer customized manufacturing services covering overhead cranes, gantry cranes, container handling cranes, RTG cranes, RMG cranes and various other lifting equipment.\",\"choose\":[{\"choose_name\":\"Safety First\",\"choose_desc\":\"All cranes meet ANSI\\/ASME &amp; CE standards, with overload protection and fail-safe design.\",\"choose_image\":\"admin\\/20260527\\/68aa6c742a2d455d1408cde608051841.webp\",\"choose_image_active\":\"admin\\/20260527\\/68aa6c742a2d455d1408cde608051841.webp\"},{\"choose_name\":\"Custom Engineering\",\"choose_desc\":\"Tailored to your facility layout, lifting height, and environmental conditions.\",\"choose_image\":\"admin\\/20260527\\/bc3eef13d7136b3c010df8c74e9d1d00.webp\",\"choose_image_active\":\"admin\\/20260527\\/bc3eef13d7136b3c010df8c74e9d1d00.webp\"},{\"choose_name\":\"Global Support\",\"choose_desc\":\"24\\/7 technical assistance, spare parts delivery, and onsite commissioning.\",\"choose_image\":\"admin\\/20260527\\/a0b999db3846ed6c0ef248ee1b2a7dd4.webp\",\"choose_image_active\":\"admin\\/20260527\\/a0b999db3846ed6c0ef248ee1b2a7dd4.webp\"},{\"choose_name\":\"Cost-Effective ROI\",\"choose_desc\":\"Energy-efficient drives and low maintenance costs maximize your investment.\",\"choose_image\":\"admin\\/20260527\\/9f36d3ed93369d35d1db1375382411bc.webp\",\"choose_image_active\":\"admin\\/20260527\\/9f36d3ed93369d35d1db1375382411bc.webp\"},{\"choose_name\":\"500+\",\"choose_desc\":\"Has received over 500 awards\",\"choose_image\":\"admin\\/20260527\\/7baaf496dd70a49db343b8ebaf1946bb.webp\",\"choose_image_active\":\"admin\\/20260527\\/7baaf496dd70a49db343b8ebaf1946bb.webp\"},{\"choose_name\":\"1200+\",\"choose_desc\":\"The team size exceeds 1200 people\",\"choose_image\":\"admin\\/20260527\\/6bda15553790b2a8b2b18244de047666.webp\",\"choose_image_active\":\"admin\\/20260527\\/6bda15553790b2a8b2b18244de047666.webp\"},{\"choose_name\":\"33\",\"choose_desc\":\"33 research and development platforms\",\"choose_image\":\"admin\\/20260527\\/85ed45386887bd62b93590e732dc8a9e.webp\",\"choose_image_active\":\"admin\\/20260527\\/85ed45386887bd62b93590e732dc8a9e.webp\"},{\"choose_name\":\"170+\",\"choose_desc\":\"Export over 170 communities\",\"choose_image\":\"admin\\/20260527\\/1a325f1189f09ee69e5b5a67dcb1cf12.webp\",\"choose_image_active\":\"admin\\/20260527\\/1a325f1189f09ee69e5b5a67dcb1cf12.webp\"}],\"faq_title\":\"FAQ\",\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq\":[{\"question\":\"What factors affect crane prices most, and how can I get a reasonable quotation?\",\"answer\":\"Many customers worry about hidden costs and inconsistent pricing when buying cranes. The actual crane price mainly depends on lifting capacity, span, lifting height, working duty, configuration standards and customized functions. Simple standard models have stable and transparent prices, while special working conditions such as explosion-proof, high-temperature, anti-corrosion and intelligent anti-sway systems will lead to different costs. We provide one-on-one tailored quotes based on your actual site conditions and usage needs, with no hidden charges, and every configuration and cost item is clearly listed for your reference.\"},{\"question\":\"Are your cranes suitable for my local industrial and environmental conditions?\",\"answer\":\"This is the key concern for overseas buyers, as different countries have different weather, site and industry requirements. Our overhead cranes, gantry cranes and port cranes can be fully adapted to various complex environments, including high temperature, heavy rain, coastal humidity, dust and strong wind conditions. We can adjust motor brands, electrical systems, anti-rust painting standards, protection grades and wind-proof devices according to your local climate, site environment and industry standards, ensuring long-term stable operation in your working scenario.\"},{\"question\":\"Do you support customized crane solutions for special working conditions?\",\"answer\":\"Standard cranes cannot meet all project needs, which is why custom solutions are essential for industrial engineering projects. We fully support personalized customization including non-standard span, special lifting height, heavy-duty working level, explosion-proof, insulation, anti-corrosion, intelligent anti-sway, remote control and automatic positioning functions. Whether it is factory indoor handling, outdoor yard operation, port container handling or metallurgy and chemical special scenarios, we can design and produce exclusive crane equipment according to your drawings and technical requirements.\"},{\"question\":\"What certifications do your cranes have for overseas export?\",\"answer\":\"Most overseas projects require official certification for customs clearance and project acceptance, which is a major pain point for many purchasers. All our cranes are manufactured in strict accordance with international standards and have complete export qualifications, including CE, ISO and other mainstream certifications. We can provide complete certification documents, inspection reports and factory qualification materials to ensure smooth customs clearance, local inspection and long-term project use in your country.\"},{\"question\":\"What after-sales support can you provide for overseas clients?\",\"answer\":\"Overseas customers are most worried about no technical support and difficult maintenance after purchasing equipment. We provide full-cycle after-sales service including installation guidance, operation training, remote technical support and lifetime after-sales consultation. We supply original spare parts at factory prices for long-term maintenance. If you encounter operation failure, equipment debugging or daily maintenance problems, our professional technical team can respond quickly to help you solve problems and ensure the cranes run stably for a long time.\"}]}'  WHERE  `option_name` = 'index_setting' [ RunTime:0.004041s ]
