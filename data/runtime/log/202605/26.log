[2026-05-26T10:39:32+08:00][sql] UPDATE `cmf_option`  SET `option_value` = '{\"28\":{\"title\":\"Overhead Crane Manufacturer | Custom Lifting Solutions\",\"description\":\"We supply single girder and double girder overhead cranes with customizable load capacity from 1 ton to 100 tons. We offer personalized design, professional on-site installation and complete after-sales support. Factory direct sales with full global certifications, ideal for factories, warehouses and workshops.\",\"selector_title\":\"How to Choose the Right Overhead Crane?\",\"selector_description\":\"If you haven’t decided yet, tell us your lifting load, span, workshop space and working conditions. You may also send factory layout plans. We will recommend the most suitable and budget-friendly overhead crane solution for you.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"General workshops, warehouses and light-duty production lines\",\"type\":\"LD Single Girder Overhead Crane\"},{\"scene\":\"Heavy industry workshops, machinery manufacturing and large processing plants\",\"type\":\"Double Girder Overhead Crane\"},{\"scene\":\"Petrochemical plants, gas stations and flammable explosive working zones\",\"type\":\"Explosion-proof Bridge Crane QB Type\"},{\"scene\":\"Low ceiling factories, compact workshops and restricted indoor spaces\",\"type\":\"Low Headroom Overhead Crane\"},{\"scene\":\"Workstation processing areas, assembly lines and local material handling zones\",\"type\":\"Floor-Mounted Jib Crane\"}],\"icon\":\"portal\\/20260526\\/dc3cacbfca4307a60e05bfb66f1d7e58.png\"},\"19\":{\"title\":\"Gantry Crane Supplier | Custom Outdoor Lifting Cranes\",\"description\":\"Durable single and double girder gantry cranes available in various specifications. Fully customized to fit your site conditions, equipped with reliable safety performance. We provide one-stop installation service and long-term after-sales maintenance, certified quality and competitive factory price.\",\"selector_title\":\"How to Choose the Right Gantry Crane?\",\"selector_description\":\"If you are still hesitating, simply inform us your lifting capacity, working span, yard space and actual operating needs. You can also share site layout drawings, and we will match you with practical and cost-effective gantry crane solutions.\",\"selector_button_text\":\"Submit Your Requirements\",\"selector_items\":[{\"scene\":\"Outdoor cargo yards, freight stations and heavy goods stacking sites\",\"type\":\"Double Girder Gantry Crane U Type\"},{\"scene\":\"Industrial sites, overseas engineering projects and high-standard logistics yards\",\"type\":\"FEM\\/DIN Double Girder Gantry Crane\"},{\"scene\":\"Side workshop passages, edge operation areas and space-saving outdoor working places\",\"type\":\"Semi Gantry Crane BMG Type\"},{\"scene\":\"Small outdoor yards, construction sites and light-duty outdoor handling places\",\"type\":\"MH Gantry Crane with Electric Hoist\"},{\"scene\":\"Open-air stockyards, railway freight yards and outdoor light cargo loading and unloading sites\",\"type\":\"L Type Single Girder Gantry Crane\"}],\"icon\":\"portal\\/20260526\\/3f915c1b01cc05b6bbf63fd0864cd3ec.png\"},\"22\":{\"title\":\"High Temperature Metallurgical Crane | Custom Heavy Duty Crane\",\"description\":\"Professional heavy-duty metallurgical cranes tailored for high temperature working environment. Custom load range and protective configurations available. Complete installation guidance and thoughtful after-sales service are provided, stable and safe for steel mill and smelting industry use.\",\"selector_title\":\"How to Choose the Right Metallurgy Crane?\",\"selector_description\":\"If you are unsure which metallurgy crane fits your production needs, just let us know your required lifting capacity, workshop span, lifting height, and actual working duty. You can also send us your workshop layout and high-temperature working environment details. We will recommend well-matched, safe and durable customized metallurgy crane solutions for your smelting and steelmaking production.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"High-temperature smelting workshops, steel mills and molten metal pouring &amp; transporting stations\",\"type\":\"Crane for Meltshop | Ladle Cranes\"},{\"scene\":\"Steel stockyards, processing workshops and heavy bulk metal material clamping &amp; transfer areas\",\"type\":\"Clamps Overhead Crane\"},{\"scene\":\"Steelmaking workshops, non-ferrous metal processing and high-temperature metallurgical production lines\",\"type\":\"Overhead Crane for Metallurgy\"},{\"scene\":\"Heavy-duty smelting workshops, molten metal handling and continuous metallurgy production sites\",\"type\":\"Metallurgy Overhead Crane QDY Type\"},{\"scene\":\"Foundry factories, casting production lines and high-temperature molten material operation areas\",\"type\":\"Foundry Casting Bridge Crane YZ Type\"}]},\"23\":{\"title\":\"Port Crane Manufacturer | Custom Dock Handling Equipment\",\"description\":\"High-efficiency port cranes for container and bulk cargo handling. All specifications can be customized according to terminal demands. We provide overall project matching, on-site commissioning and global after-sales service, certified products to meet international shipping operation standards.\",\"selector_title\":\"How to Select Suitable Port Cranes?\",\"selector_description\":\"If you feel confused about picking ideal port handling cranes, just tell us your required load capacity, working radius, berth size and daily cargo throughput. You may also send over your port layout and operation plans. We will tailor reliable, budget-friendly port crane solutions perfectly fitting your actual terminal working conditions.\",\"selector_button_text\":\"Check Best Crane Solution\",\"selector_items\":[{\"scene\":\"Flexible container yard operation, terminal container stacking, mobile cargo arrangement, no fixed rail restriction\",\"type\":\"Rubber Tyred Container Gantry Cranes\"},{\"scene\":\"Large container terminals, high-density container storage areas, high-efficiency automated port logistics zones\",\"type\":\"RMG Rail Mounted Container Gantry Cranes\"},{\"scene\":\"Coastal large wharves, international freight ports, large vessel container loading and unloading operations\",\"type\":\"Ship-to-Shore Container Cranes\"},{\"scene\":\"River wharves, inland ports, bulk cargo terminals and general cargo berth handling work\",\"type\":\"MQ Portal Crane\"},{\"scene\":\"Yacht marinas, shipyards, leisure boat docks, vessel launching and daily docking transfer scenarios\",\"type\":\"Boat and Yacht Handling Crane\"}],\"icon\":\"portal\\/20260526\\/0c759480df34db15f30962a90a48fdff.png\"},\"25\":{\"title\":\"Light Crane Supplier | Custom Light Lifting Crane Solutions\",\"description\":\"We offer versatile light cranes with flexible specifications and customizable designs. Suitable for small workshops, warehouses and light duty handling work. Full installation service and reliable after-sales support available. Certified quality with factory direct price\",\"selector_title\":\"How to Choose the Right Light Crane?\",\"selector_description\":\"If you are unsure which light lifting equipment fits your needs, just let us know your required lifting weight, installation space, working height and daily usage frequency. You can also send us your workshop layout and working area plans. We will recommend well-matched, space-saving and budget-friendly light crane solutions for you.\",\"selector_button_text\":\"Request Quick Quotation\",\"selector_items\":[{\"scene\":\"Independent workshop zones, processing stations and flexible local material handling areas\",\"type\":\"Free-Standing Jib Crane\"},{\"scene\":\"Long-span production lines, workshop side passages and linear workpiece transfer sites\",\"type\":\"Wall Rail Jib Crane\"},{\"scene\":\"Chemical plants, oil depots, gas workshops and flammable explosive working environments\",\"type\":\"Explosion-Proof Jib Crane\"},{\"scene\":\"Narrow workshop corners, assembly stations and space-limited indoor operation spots\",\"type\":\"Wall Fixed Jib Crane\"},{\"scene\":\"Factory interior assembly lines, low-rise workshops and compact indoor light cargo conveying places\",\"type\":\"Electric Suspension Crane\"}],\"icon\":\"portal\\/20260526\\/392755e5b1bf24350bf3140108296c30.png\"},\"30\":{\"title\":\"Electric Hoist | Custom Industrial Hoist Supplier\",\"description\":\"Professional electric hoist manufacturer offering custom chain hoist and wire rope hoist. 1–50 ton customizable lifting capacity, globally certified with factory direct pricing.\",\"selector_title\":\"How to Choose the Right Electric Hoist?\",\"selector_description\":\"If you are unsure which electric hoist fits your lifting needs, just let us know your required lifting capacity, lifting height, working speed and daily operating frequency. You can also send us your workshop space conditions and application scenarios. We will recommend well-matched, cost-effective and safe customized electric hoist solutions for your indoor and outdoor material handling work.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"Flammable and explosive workshops, chemical plants, oil and gas industrial lifting sites\",\"type\":\"HB Explosion-Proof Electric Hoist\"},{\"scene\":\"Precision assembly workshops, factory production lines and lightweight frequent handling scenarios\",\"type\":\"European Electric Hoist\"},{\"scene\":\"Large-span factories, heavy-duty processing workshops and high-precision material moving areas\",\"type\":\"European Hoist Trolley Double Girder\"},{\"scene\":\"General industrial workshops, warehouses and frequent light &amp; medium load lifting operations\",\"type\":\"CD1 MD1 Wire Rope Electric Hoist\"},{\"scene\":\"Construction sites, factory cargo traction and long-distance heavy material pulling scenarios\",\"type\":\"Electric Winch\"}],\"icon\":\"portal\\/20260526\\/84e137e96f2ab47c37fe0200f16f6c94.png\"},\"27\":{\"title\":\"\",\"description\":\"\",\"selector_title\":\"\",\"selector_description\":\"\",\"selector_button_text\":\"\",\"selector_items\":[],\"icon\":\"portal\\/20260526\\/4beb89512983a9fe8187eadf6479e107.png\"}}'  WHERE  `option_name` = 'product_category_hero_settings' [ RunTime:0.000706s ]
