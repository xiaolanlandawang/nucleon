[2026-05-26T10:37:43+08:00][sql] UPDATE `cmf_option`  SET `option_value` = '{\"28\":{\"title\":\"Overhead Crane Manufacturer | Custom Lifting Solutions\",\"description\":\"We supply single girder and double girder overhead cranes with customizable load capacity from 1 ton to 100 tons. We offer personalized design, professional on-site installation and complete after-sales support. Factory direct sales with full global certifications, ideal for factories, warehouses and workshops.\",\"selector_title\":\"How to Choose the Right Overhead Crane?\",\"selector_description\":\"If you haven’t decided yet, tell us your lifting load, span, workshop space and working conditions. You may also send factory layout plans. We will recommend the most suitable and budget-friendly overhead crane solution for you.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"General workshops, warehouses and light-duty production lines\",\"type\":\"LD Single Girder Overhead Crane\"},{\"scene\":\"Heavy industry workshops, machinery manufacturing and large processing plants\",\"type\":\"Double Girder Overhead Crane\"},{\"scene\":\"Petrochemical plants, gas stations and flammable explosive working zones\",\"type\":\"Explosion-proof Bridge Crane QB Type\"},{\"scene\":\"Low ceiling factories, compact workshops and restricted indoor spaces\",\"type\":\"Low Headroom Overhead Crane\"},{\"scene\":\"Workstation processing areas, assembly lines and local material handling zones\",\"type\":\"Floor-Mounted Jib Crane\"}],\"icon\":\"portal\\/20260526\\/dc3cacbfca4307a60e05bfb66f1d7e58.png\"},\"19\":{\"title\":\"Gantry Crane Supplier | Custom Outdoor Lifting Cranes\",\"description\":\"Durable single and double girder gantry cranes available in various specifications. Fully customized to fit your site conditions, equipped with reliable safety performance. We provide one-stop installation service and long-term after-sales maintenance, certified quality and competitive factory price.\",\"selector_title\":\"How to Choose the Right Gantry Crane?\",\"selector_description\":\"If you are still hesitating, simply inform us your lifting capacity, working span, yard space and actual operating needs. You can also share site layout drawings, and we will match you with practical and cost-effective gantry crane solutions.\",\"selector_button_text\":\"Submit Your Requirements\",\"selector_items\":[{\"scene\":\"Outdoor cargo yards, freight stations and heavy goods stacking sites\",\"type\":\"Double Girder Gantry Crane U Type\"},{\"scene\":\"Industrial sites, overseas engineering projects and high-standard logistics yards\",\"type\":\"FEM\\/DIN Double Girder Gantry Crane\"},{\"scene\":\"Side workshop passages, edge operation areas and space-saving outdoor working places\",\"type\":\"Semi Gantry Crane BMG Type\"},{\"scene\":\"Small outdoor yards, construction sites and light-duty outdoor handling places\",\"type\":\"MH Gantry Crane with Electric Hoist\"},{\"scene\":\"Open-air stockyards, railway freight yards and outdoor light cargo loading and unloading sites\",\"type\":\"L Type Single Girder Gantry Crane\"}],\"icon\":\"portal\\/20260526\\/3f915c1b01cc05b6bbf63fd0864cd3ec.png\"},\"22\":{\"title\":\"High Temperature Metallurgical Crane | Custom Heavy Duty Crane\",\"description\":\"Professional heavy-duty metallurgical cranes tailored for high temperature working environment. Custom load range and protective configurations available. Complete installation guidance and thoughtful after-sales service are provided, stable and safe for steel mill and smelting industry use.\",\"selector_title\":\"How to Choose the Right Metallurgy Crane?\",\"selector_description\":\"If you are unsure which metallurgy crane fits your production needs, just let us know your required lifting capacity, workshop span, lifting height, and actual working duty. You can also send us your workshop layout and high-temperature working environment details. We will recommend well-matched, safe and durable customized metallurgy crane solutions for your smelting and steelmaking production.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"High-temperature smelting workshops, steel mills and molten metal pouring &amp; transporting stations\",\"type\":\"Crane for Meltshop | Ladle Cranes\"},{\"scene\":\"Steel stockyards, processing workshops and heavy bulk metal material clamping &amp; transfer areas\",\"type\":\"Clamps Overhead Crane\"},{\"scene\":\"Steelmaking workshops, non-ferrous metal processing and high-temperature metallurgical production lines\",\"type\":\"Overhead Crane for Metallurgy\"},{\"scene\":\"Heavy-duty smelting workshops, molten metal handling and continuous metallurgy production sites\",\"type\":\"Metallurgy Overhead Crane QDY Type\"},{\"scene\":\"Foundry factories, casting production lines and high-temperature molten material operation areas\",\"type\":\"Foundry Casting Bridge Crane YZ Type\"}]},\"23\":{\"title\":\"Port Crane Manufacturer | Custom Dock Handling Equipment\",\"description\":\"High-efficiency port cranes for container and bulk cargo handling. All specifications can be customized according to terminal demands. We provide overall project matching, on-site commissioning and global after-sales service, certified products to meet international shipping operation standards.\",\"selector_title\":\"How to Select Suitable Port Cranes?\",\"selector_description\":\"If you feel confused about picking ideal port handling cranes, just tell us your required load capacity, working radius, berth size and daily cargo throughput. You may also send over your port layout and operation plans. We will tailor reliable, budget-friendly port crane solutions perfectly fitting your actual terminal working conditions.\",\"selector_button_text\":\"Check Best Crane Solution\",\"selector_items\":[{\"scene\":\"Flexible container yard operation, terminal container stacking, mobile cargo arrangement, no fixed rail restriction\",\"type\":\"Rubber Tyred Container Gantry Cranes\"},{\"scene\":\"Large container terminals, high-density container storage areas, high-efficiency automated port logistics zones\",\"type\":\"RMG Rail Mounted Container Gantry Cranes\"},{\"scene\":\"Coastal large wharves, international freight ports, large vessel container loading and unloading operations\",\"type\":\"Ship-to-Shore Container Cranes\"},{\"scene\":\"River wharves, inland ports, bulk cargo terminals and general cargo berth handling work\",\"type\":\"MQ Portal Crane\"},{\"scene\":\"Yacht marinas, shipyards, leisure boat docks, vessel launching and daily docking transfer scenarios\",\"type\":\"Boat and Yacht Handling Crane\"}],\"icon\":\"portal\\/20260526\\/0c759480df34db15f30962a90a48fdff.png\"},\"25\":{\"title\":\"Light Crane Supplier | Custom Light Lifting Crane Solutions\",\"description\":\"We offer versatile light cranes with flexible specifications and customizable designs. Suitable for small workshops, warehouses and light duty handling work. Full installation service and reliable after-sales support available. Certified quality with factory direct price\",\"selector_title\":\"How to Choose the Right Light Crane?\",\"selector_description\":\"If you are unsure which light lifting equipment fits your needs, just let us know your required lifting weight, installation space, working height and daily usage frequency. You can also send us your workshop layout and working area plans. We will recommend well-matched, space-saving and budget-friendly light crane solutions for you.\",\"selector_button_text\":\"Request Quick Quotation\",\"selector_items\":[{\"scene\":\"Independent workshop zones, processing stations and flexible local material handling areas\",\"type\":\"Free-Standing Jib Crane\"},{\"scene\":\"Long-span production lines, workshop side passages and linear workpiece transfer sites\",\"type\":\"Wall Rail Jib Crane\"},{\"scene\":\"Chemical plants, oil depots, gas workshops and flammable explosive working environments\",\"type\":\"Explosion-Proof Jib Crane\"},{\"scene\":\"Narrow workshop corners, assembly stations and space-limited indoor operation spots\",\"type\":\"Wall Fixed Jib Crane\"},{\"scene\":\"Factory interior assembly lines, low-rise workshops and compact indoor light cargo conveying places\",\"type\":\"Electric Suspension Crane\"}],\"icon\":\"\"},\"30\":{\"title\":\"Electric Hoist | Custom Industrial Hoist Supplier\",\"description\":\"Professional electric hoist manufacturer offering custom chain hoist and wire rope hoist. 1–50 ton customizable lifting capacity, globally certified with factory direct pricing.\",\"selector_title\":\"How to Choose the Right Electric Hoist?\",\"selector_description\":\"If you are unsure which electric hoist fits your lifting needs, just let us know your required lifting capacity, lifting height, working speed and daily operating frequency. You can also send us your workshop space conditions and application scenarios. We will recommend well-matched, cost-effective and safe customized electric hoist solutions for your indoor and outdoor material handling work.\",\"selector_button_text\":\"Get Professional Advice\",\"selector_items\":[{\"scene\":\"Flammable and explosive workshops, chemical plants, oil and gas industrial lifting sites\",\"type\":\"HB Explosion-Proof Electric Hoist\"},{\"scene\":\"Precision assembly workshops, factory production lines and lightweight frequent handling scenarios\",\"type\":\"European Electric Hoist\"},{\"scene\":\"Large-span factories, heavy-duty processing workshops and high-precision material moving areas\",\"type\":\"European Hoist Trolley Double Girder\"},{\"scene\":\"General industrial workshops, warehouses and frequent light &amp; medium load lifting operations\",\"type\":\"CD1 MD1 Wire Rope Electric Hoist\"},{\"scene\":\"Construction sites, factory cargo traction and long-distance heavy material pulling scenarios\",\"type\":\"Electric Winch\"}],\"icon\":\"portal\\/20260526\\/84e137e96f2ab47c37fe0200f16f6c94.png\"},\"27\":{\"title\":\"\",\"description\":\"\",\"selector_title\":\"\",\"selector_description\":\"\",\"selector_button_text\":\"\",\"selector_items\":[],\"icon\":\"portal\\/20260526\\/4beb89512983a9fe8187eadf6479e107.png\"}}'  WHERE  `option_name` = 'product_category_hero_settings' [ RunTime:0.002766s ]
[2026-05-26T10:37:43+08:00][sql] SELECT * FROM `cmf_option` WHERE  `option_name` = 'product_category_faq_settings' LIMIT 1 [ RunTime:0.000420s ]
[2026-05-26T10:37:43+08:00][sql] UPDATE `cmf_option`  SET `option_value` = '{\"28\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What factors should I consider when choosing a suitable overhead crane?\",\"answer\":\"When buying a overhead crane, many customers only focus on price and end up with equipment that does not match their workshop conditions. The most important factors are lifting weight, workshop span, ceiling height, working frequency and working environment. We configure the most suitable crane solution according to your actual site data, avoiding over configuration wasting budget or insufficient performance affecting production.\"},{\"question\":\"Are your overhead cranes suitable for high-frequency heavy industrial use?\",\"answer\":\"Many ordinary cranes on the market are prone to deformation, motor heating and frequent failures after long-time heavy use. Our single and double girder overhead cranes adopt reinforced steel structure and industrial-grade core components, designed for long-hour, high-frequency factory operation. Stable performance, low failure rate, and effectively reduce your production shutdown losses.\"},{\"question\":\"Can you modify and customize the crane for special workshop conditions?\",\"answer\":\"Many customers have troubles such as low factory ceiling, limited installation space, special rail positions or dust\\/high temperature environment. We support full non-standard customization, including low-headroom design, anti-corrosion, explosion-proof, dust-proof and customized span and height. No need to renovate your workshop, the crane can be perfectly installed and used.\"},{\"question\":\"How about your overseas after-sales service and technical support?\",\"answer\":\"Overseas users are most worried about no technical support and difficult maintenance after purchasing equipment. We provide lifelong online technical guidance, remote debugging and fault diagnosis. Complete English installation manuals, video tutorials and sufficient spare parts support ensure you can solve daily maintenance problems by yourself quickly.\"},{\"question\":\"Do your overhead cranes meet international safety and quality standards?\",\"answer\":\"Unqualified cranes will cause customs detention and potential safety hazards. All our overhead cranes comply with CE, ISO, FEM and other international standards, with complete test reports and certification documents. Strict factory quality inspection ensures stable safety performance and fully meets local industrial safety requirements.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"30\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What lifting capacities do your electric hoists cover?\",\"answer\":\"Our electric hoists range from 0.5 ton to 50 ton. Standard and heavy-duty types are both available, fitting daily workshop handling, heavy cargo hoisting and industrial assembly work.\"},{\"question\":\"What working environments can these hoists adapt to?\",\"answer\":\"They support indoor factory, warehouse, construction site and outdoor open areas. Custom anti-corrosion, dustproof and waterproof versions can be made for humid, coastal and harsh working conditions.\"},{\"question\":\"How about running stability and safety performance?\",\"answer\":\"Built with reliable braking and overload protection systems. It runs smoothly with little vibration and noise. All products comply with international safety norms to avoid accidental slipping and ensure operational security.\"},{\"question\":\"Is daily maintenance hard and what is service life?\",\"answer\":\"Structure is compact with few vulnerable parts. Only regular lubrication and simple routine check are needed. Normal use can reach 10-18 years long service life.\"},{\"question\":\"Can you make customized electric hoist solutions?\",\"answer\":\"Sure. We adjust lifting height, running speed and voltage as your demands. Professional technical team offers tailored design to match your overhead crane, jib crane and actual working demands.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"19\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What site conditions are suitable for a gantry crane?\",\"answer\":\"Gantry cranes are perfect for outdoor yards, ports, construction sites and workshops without overhead roof rails. It runs on ground rails, requires no factory ceiling support, and fits most open-air material handling scenarios.\"},{\"question\":\"What is the difference between a gantry crane and an overhead crane?\",\"answer\":\"The biggest difference is the installation way. Gantry cranes stand on the ground with steel legs, ideal for outdoor use. Overhead cranes rely on building frames and are mainly for indoor workshops. Most outdoor projects choose gantry cranes for better flexibility.\"},{\"question\":\"Can you customize the span, height and tonnage of gantry cranes?\",\"answer\":\"Yes. We fully customize span, lifting height, capacity, power voltage and control methods. No matter small yard or large port cargo handling, we can adjust the parameters to match your actual site exactly.\"},{\"question\":\"How long is the service life and what about maintenance?\",\"answer\":\"Our heavy-duty gantry cranes feature solid steel structure and wear-resistant parts. With regular simple maintenance, the service life can reach 15–20 years. We provide clear maintenance guidance and global after-sales support.\"},{\"question\":\"What is your delivery time and export service?\",\"answer\":\"Standard gantry crane models have short production cycles. Customized products also have stable lead time. We provide full export packaging, shipping documents, installation manuals and remote technical guidance for overseas clients.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"23\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What features make port crane fit seaside harsh working environment?\",\"answer\":\"Built with corrosion resistant materials, it stands wind, salt fog and humid weather. Solid structure keeps stable performance during long term outdoor cargo lifting at docks.\"},{\"question\":\"What cargo types can this port crane handle?\",\"answer\":\"It works well for container goods, bulk materials and heavy port cargo. Suitable for loading, unloading and stock moving tasks at all kinds of seaports and harbors.\"},{\"question\":\"Can we adjust crane size and load capacity for our dock space?\",\"answer\":\"Full customization is available. We tailor span, lifting height and tonnage according to actual dock layout, perfectly matching local operation demands.\"},{\"question\":\"How to guarantee safe running during frequent heavy lifting work?\",\"answer\":\"Equipped with overload protection and anti sway system. Strict factory testing ensures reliable operation, greatly lower accident risks in busy port work.\"},{\"question\":\"What support can you offer after placing order?\",\"answer\":\"We provide complete export documents, professional installation guide and long distance technical support. Fast response solves daily operation troubles timely.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"25\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What is the real advantage of a jib crane over bridge cranes?\",\"answer\":\"Unlike bridge cranes that need full overhead rails, a jib crane runs on a single mast or wall mount. It saves 70% floor space, serves localized work zones with 180°–360° rotation, and costs 30–50% less. Perfect for assembly stations, machine shops, and tight warehouses where big cranes are overkill.\"},{\"question\":\"Can you customize jib cranes for my workshop’s limited space?\",\"answer\":\"Absolutely. We tailor capacity (0.25–10 ton), boom length, rotation angle (180°\\/270°\\/360°) and mounting type (freestanding\\/wall-mounted). Wall-mounted models save floor space; freestanding ones need only a small foundation. We’ll even send engineers to check your site and draw free layouts.\"},{\"question\":\"How long does delivery and installation take?\",\"answer\":\"Standard models ship in 2–4 weeks. Custom units (special boom, outdoor coating, etc.) take 6–8 weeks. Installation is quick: wall-mounted in 1 day, freestanding in 2 days. We provide full drawings and video guides; if needed, our technicians can supervise installation onsite.\"},{\"question\":\"Is maintenance complicated? How safe is it?\",\"answer\":\"Super easy. With fewer moving parts than overhead cranes, maintenance only needs monthly lubrication and 6–12 month inspections. All units meet CE\\/ISO standards, with overload protection, emergency stop, and anti-sway devices. Used properly, lifespan reaches 10–20 years. Safety is always our top priority.\"},{\"question\":\"Can jib cranes work outdoors or in harsh environments?\",\"answer\":\"Yes. We offer hot-dip galvanized or painted finishes for rust resistance, plus waterproof and dustproof electrical components. They work reliably in -20°C to +40°C. For coastal or high-humidity areas, we add extra anti-corrosion treatment. Many clients use them in yards, ports, and construction sites without issues.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"22\":{\"faq_title\":\"\",\"faq\":[{\"question\":\"What makes a metallurgical crane different from ordinary overhead cranes?\",\"answer\":\"Metallurgical cranes are specially upgraded for high-temperature, high-frequency and heavy-duty working conditions. Unlike ordinary workshop cranes, they adopt high-temperature resistant wires, heat insulation protection and reinforced structural parts, which can stably handle molten metal and high-temperature materials in steel mills and smelting plants.\"},{\"question\":\"Can your metallurgical crane work continuously in high-temperature smelting workshops?\",\"answer\":\"Absolutely. Our metallurgical cranes are professionally designed for harsh high-temperature environments. Key components are equipped with heat dissipation and anti-scald protection devices, supporting long-time uninterrupted frequent operation in smelting, casting and steel making workshops, with low failure rate.\"},{\"question\":\"Is your metallurgical crane safe for molten steel and ladle handling?\",\"answer\":\"Yes. All our metallurgical lifting cranes are equipped with double brake protection, overload limit and emergency stop system. The whole machine meets industrial metallurgy safety standards, effectively avoiding slipping and falling risks during molten metal and ladle transportation, ensuring on-site operation safety.\"},{\"question\":\"Can you customize metallurgical cranes for special working conditions?\",\"answer\":\"We support full personalized customization. According to your workshop temperature, lifting tonnage, working frequency and site space, we can adjust the crane span, lifting height, protection grade and control mode, to perfectly match your unique metallurgical production needs.\"},{\"question\":\"What is the service life and daily maintenance of metallurgical cranes?\",\"answer\":\"With reinforced industrial structure and anti-high-temperature wear-resistant accessories, our metallurgical cranes have a longer service life than ordinary cranes. Daily maintenance is simple. We provide exclusive metallurgical equipment maintenance manuals and remote technical guidance for global users to reduce operating costs.\"}],\"faq_contact_title\":\"Can not Find Your Question?\",\"faq_contact_desc\":\"If you can not find the answer, contact us and let us know how we can help you.\",\"faq_contact_btn_text\":\"Contact Us\",\"faq_contact_btn_link\":\"\"},\"27\":{\"faq_title\":\"\",\"faq\":[],\"faq_contact_title\":\"\",\"faq_contact_desc\":\"\",\"faq_contact_btn_text\":\"\",\"faq_contact_btn_link\":\"\"}}'  WHERE  `option_name` = 'product_category_faq_settings' [ RunTime:0.000436s ]
