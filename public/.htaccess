<IfModule mod_rewrite.c>
  Options +FollowSymlinks -Indexes
  RewriteEngine On
  # 站点地图路由规则
  RewriteRule ^sitemap\.xml$ index.php?s=/portal/sitemap/index [QSA,PT,L]
  RewriteRule ^sitemap-pages\.xml$ index.php?s=/portal/sitemap/pages [QSA,PT,L]
  RewriteRule ^sitemap-products\.xml$ index.php?s=/portal/sitemap/products [QSA,PT,L]
  RewriteRule ^sitemap-cases\.xml$ index.php?s=/portal/sitemap/cases [QSA,PT,L]
  RewriteRule ^sitemap-news\.xml$ index.php?s=/portal/sitemap/news [QSA,PT,L]
  
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php?/$1 [QSA,PT,L]
</IfModule>
